<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BitReaper</AssemblyName>
    <RootNamespace>BitReaper</RootNamespace>
    <ApplicationIcon>Assets\BitReaper.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>BitReaper</Product>
    <Description>A synthwave disk-space analyzer: fast tree view, drag-and-drop collector, bulk delete.</Description>
    <Company>The BitReaper contributors</Company>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The artwork is shared with the macOS app: it lives in the asset catalog at the repo root. -->
  <ItemGroup>
    <Resource Include="..\..\Resources\Assets.xcassets\Logo.imageset\Logo.png" Link="Assets\Logo.png" />
    <Resource Include="..\..\Resources\Assets.xcassets\ReaperDisk.imageset\ReaperDisk.png" Link="Assets\ReaperDisk.png" />
    <Resource Include="..\..\Resources\Assets.xcassets\ReaperFolder.imageset\ReaperFolder.png" Link="Assets\ReaperFolder.png" />
    <Resource Include="..\..\Resources\Assets.xcassets\ReaperPeek.imageset\ReaperPeek.png" Link="Assets\ReaperPeek.png" />
    <Resource Include="..\..\Resources\Assets.xcassets\ReaperStanding.imageset\ReaperStanding.png" Link="Assets\ReaperStanding.png" />
    <Resource Include="..\..\Resources\Assets.xcassets\SunsetBanner.imageset\SunsetBanner.png" Link="Assets\SunsetBanner.png" />
    <Resource Include="Assets\BitReaper.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BitReaper.Tests" />
  </ItemGroup>

</Project>
